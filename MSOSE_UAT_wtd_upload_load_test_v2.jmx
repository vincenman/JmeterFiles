              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="app-uploader header" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">app-uploader</stringProp>
                    <stringProp name="Header.value">Y</stringProp>
