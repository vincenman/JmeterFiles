              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="capture rotated token + row meta" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def h = prev.getResponseHeaders()
if (h != null) {
    def m = (h =~ /(?im)^X-CSRF-TOKEN:\s*(\S+)/)
    if (m.find()) { vars.put(&apos;csrfToken&apos;, m.group(1).trim()) }
}
def n = vars.get(&apos;uploadedNames&apos;)
def name = vars.get(&apos;uploadName&apos;)
if (name != null) { vars.put(&apos;uploadedNames&apos;, (n == null || n.length() == 0) ? name : n + &apos;,&apos; + name) }
def meta = vars.get(&apos;uploadedMeta&apos;)
def row = name + &apos;|&apos; + vars.get(&apos;uploadSize&apos;) + &apos;|&apos; + vars.get(&apos;uploadOrigName&apos;)
vars.put(&apos;uploadedMeta&apos;, (meta == null || meta.length() == 0) ? row : meta + &apos;;&apos; + row)</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
