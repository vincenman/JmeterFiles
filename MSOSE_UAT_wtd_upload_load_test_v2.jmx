              <hashTree/>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="build upload name" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def idx = vars.get(&apos;__jm__UploadLoop__idx&apos;)
def name = &apos;o_lt&apos; + ctx.getThreadNum() + &apos;_&apos; + System.currentTimeMillis() + &apos;_&apos; + idx + &apos;.&apos; + vars.get(&apos;upload_ext&apos;)
vars.put(&apos;uploadName&apos;, name)
vars.put(&apos;uploadSize&apos;, String.valueOf(new File(vars.get(&apos;upload_file&apos;)).length()))
vars.put(&apos;uploadOrigName&apos;, new File(vars.get(&apos;upload_file&apos;)).getName())</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="assert 200" enabled="true">
