            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="assert temp files not persisted" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def names = vars.get(&apos;uploadedNames&apos;)
def body = prev.getResponseDataAsString()
if (names != null) {
    if (names.length() != 0) {
        def bad = []
        names.split(&apos;,&apos;).each { n -&gt; if (n.length() != 0) { if (body.contains(n)) { bad.add(n) } } }
        if (bad.size() != 0) {
            AssertionResult.setFailure(true)
            AssertionResult.setFailureMessage(&apos;Uploaded temp names are present in the reloaded page: &apos; + bad.join(&apos;,&apos;))
        }
    }
}
def cnt = 0
if (names != null) { if (names.length() != 0) { cnt = names.split(&apos;,&apos;).length } }
log.info(&apos;VERIFY pages: uploads=&apos; + cnt + &apos; persistedInPageList=&apos; + (names != null ? (names.length() != 0 ? &apos;checked&apos; : &apos;n/a&apos;) : &apos;n/a&apos;))</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
