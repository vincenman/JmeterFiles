            <stringProp name="script">log.warn(&apos;persist_uploads=true: the next request writes &apos; + vars.get(&apos;num_uploads&apos;) + &apos; files to the UAT draft and replaces the current document set of this wizard step&apos;)
SampleResult.setResponseData(&apos;persist mode enabled&apos;, &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="build persist form body" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def tok = vars.get(&apos;pageToken&apos;)
def meta = vars.get(&apos;uploadedMeta&apos;)
def sb = new StringBuilder()
sb.append(&apos;struts.token.name=token&amp;token=&apos;).append(java.net.URLEncoder.encode(tok, &apos;UTF-8&apos;))
def rows = meta.split(&apos;;&apos;)
sb.append(&apos;&amp;TR1_count=&apos;).append(rows.length)
int i = 0
rows.each { r -&gt;
    def p = r.split(&apos;\\|&apos;)
    sb.append(&apos;&amp;TR1_&apos;).append(i).append(&apos;_tmpname=&apos;).append(java.net.URLEncoder.encode(p[0], &apos;UTF-8&apos;))
    sb.append(&apos;&amp;TR1_&apos;).append(i).append(&apos;_size=&apos;).append(p[1])
    sb.append(&apos;&amp;TR1_&apos;).append(i).append(&apos;_name=&apos;).append(java.net.URLEncoder.encode(p[2], &apos;UTF-8&apos;))
    sb.append(&apos;&amp;TR1_&apos;).append(i).append(&apos;_status=done&apos;)
    i++
}
vars.put(&apos;persistBody&apos;, sb.toString())</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
